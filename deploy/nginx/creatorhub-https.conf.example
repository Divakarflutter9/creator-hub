# Final, dedicated vhost. Install only after the certificate exists.
# It listens only for this hostname and proxies to CreatorHub's loopback port.
server {
    listen 80;
    listen [::]:80;
    server_name creatorhub.fastcopies.in;
    server_tokens off;
    client_max_body_size 26m;

    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name creatorhub.fastcopies.in;
    server_tokens off;
    client_max_body_size 26m;

    ssl_certificate /etc/letsencrypt/live/creatorhub.fastcopies.in/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/creatorhub.fastcopies.in/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:creatorhub_tls:10m;
    ssl_session_timeout 1d;

    limit_req_status 429;
    location ~ ^/accounts/(signup|login|password-reset|reset|resend-verification)/ {
        limit_req zone=creatorhub_auth burst=10 nodelay;
        proxy_pass http://127.0.0.1:8017;
        include /etc/nginx/snippets/creatorhub-proxy-params.conf;
    }

    location ~ ^/resources/[^/]+/(download|report)/ {
        limit_req zone=creatorhub_sensitive burst=30 nodelay;
        proxy_pass http://127.0.0.1:8017;
        include /etc/nginx/snippets/creatorhub-proxy-params.conf;
        proxy_buffering off;
    }

    location = /healthz/ {
        access_log off;
        proxy_pass http://127.0.0.1:8017;
        include /etc/nginx/snippets/creatorhub-proxy-params.conf;
    }

    location / {
        proxy_pass http://127.0.0.1:8017;
        include /etc/nginx/snippets/creatorhub-proxy-params.conf;
    }
}
