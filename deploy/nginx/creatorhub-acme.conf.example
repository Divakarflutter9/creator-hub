# Temporary site-specific HTTP vhost used only to obtain the first TLS certificate.
# This file is specific to creatorhub.fastcopies.in.
server {
    listen 80;
    listen [::]:80;
    server_name creatorhub.fastcopies.in;
    server_tokens off;
    client_max_body_size 26m;

    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/letsencrypt;
        default_type text/plain;
        try_files $uri =404;
    }

    location / {
        return 404;
    }
}
