# Copy to /etc/creatorhub/creatorhub.env and set restrictive permissions.
DJANGO_ENV_FILE=/etc/creatorhub/creatorhub.env
DJANGO_SECRET_KEY=REPLACE_WITH_A_RANDOM_VALUE_OF_AT_LEAST_50_CHARACTERS
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=creatorhub.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://creatorhub.example.com
DJANGO_TRUST_PROXY=1
DJANGO_SSL_REDIRECT=1
DJANGO_HSTS_SECONDS=300
DJANGO_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_HSTS_PRELOAD=0
DJANGO_TIME_ZONE=Asia/Kolkata
DJANGO_LOG_LEVEL=INFO

POSTGRES_DB=creatorhub
POSTGRES_USER=creatorhub
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer
POSTGRES_CONN_MAX_AGE=60
PGPASSFILE=/var/lib/creatorhub/.pgpass

PRIVATE_MEDIA_ROOT=/var/lib/creatorhub/private

DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DEFAULT_FROM_EMAIL="CreatorHub <no-reply@example.com>"
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=REPLACE_WITH_SMTP_USERNAME
EMAIL_HOST_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
